rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    function isAdminOrStaff() {
      return hasRole('admin') || hasRole('staff');
    }

    function ownsDelivery() {
      return signedIn() && resource.data.rider_id == request.auth.uid;
    }

    function createsOwnDelivery() {
      return signedIn() && request.resource.data.rider_id == request.auth.uid;
    }

    function ownsCustomerRecord(customerId) {
      return signedIn() && request.auth.uid == customerId;
    }

    match /customers/{customerId} {
      allow create: if signedIn() && request.auth.uid == customerId;
      allow read, update: if ownsCustomerRecord(customerId) || isAdminOrStaff();
      allow delete: if hasRole('admin');
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.customerId == request.auth.uid || isAdminOrStaff();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdminOrStaff());
      allow create, update, delete: if isAdminOrStaff();
    }

    match /companies/{document=**} {
      allow read: if signedIn();
      allow write: if isAdminOrStaff();
    }

    match /departments/{document=**} {
      allow read: if signedIn();
      allow write: if isAdminOrStaff();
    }

    match /branches/{document=**} {
      allow read: if signedIn();
      allow write: if isAdminOrStaff();
    }

    match /staff/{staffId} {
      allow read: if signedIn();
      allow write: if hasRole('admin');
    }

    match /riders/{riderId} {
      allow read: if signedIn() && (request.auth.uid == riderId || isAdminOrStaff());
      allow create: if signedIn()
        && request.auth.uid == riderId
        && request.resource.data.firebase_uid == request.auth.uid
        && !request.resource.data.keys().hasAny(['Password', 'password']);
      allow update: if signedIn()
        && request.auth.uid == riderId
        && request.resource.data.firebase_uid == request.auth.uid
        && !request.resource.data.keys().hasAny(['Password', 'password']);
      allow delete: if hasRole('admin');
      allow write: if isAdminOrStaff();
    }

    match /receivers/{document=**} {
      allow read, write: if signedIn();
    }

    match /atrRequests/{document=**} {
      allow read, write: if isAdminOrStaff();
    }

    match /courierRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read, update: if signedIn() && (resource.data.customerId == request.auth.uid || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }

    match /trips/{document=**} {
      allow read, write: if isAdminOrStaff();
    }

    match /deliveries/{deliveryId} {
      allow read: if isAdminOrStaff() || ownsDelivery();
      allow create: if isAdminOrStaff() || createsOwnDelivery();
      allow update: if isAdminOrStaff() || ownsDelivery();
      allow delete: if isAdminOrStaff();
    }

    match /riderLocations/{riderId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == riderId
        && request.resource.data.rider_id == request.auth.uid;
      allow delete: if hasRole('admin');
    }

    match /invoices/{invoiceId} {
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdminOrStaff());
      allow write: if isAdminOrStaff();
    }

    match /payments/{paymentId} {
      allow read: if signedIn() && isAdminOrStaff();
      allow write: if isAdminOrStaff();
    }
  }
}
